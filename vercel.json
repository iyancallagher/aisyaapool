{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "builds": [
        { "src": "api/lambda.php", "use": "vercel-php@0.9.0" },
        { "src": "public/**", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/build/(.*)", "dest": "/public/build/$1" },
        { "src": "/(.*)", "dest": "/api/lambda.php" }
    ]
}